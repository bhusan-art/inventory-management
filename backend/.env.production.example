# ---------------------------------------------------------------------------
# PRODUCTION environment. Copy to .env.production and fill in. Never commit it.
#
# Every value below is checked at boot by productionConfigProblems() in
# src/config/env.js. The process REFUSES TO START and prints every problem at
# once rather than one per restart. That is deliberate: each of these
# misconfigurations starts cleanly and fails somewhere else entirely.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Never "silent" in production — an incident would leave no trace. Refused at boot.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
#
# Two requirements, both enforced at boot:
#
#  - CREDENTIALS. The production stack starts mongod with --auth, and a URI
#    without them fails with an authentication error that reads like a database
#    fault rather than a configuration one.
#  - replicaSet. Transactions are unavailable on a standalone mongod and every
#    stock-moving operation in this system depends on them. Standalone does not
#    error; the transactions silently do nothing.
#
# Create the user first:
#   docker compose -f docker-compose.prod.yml exec mongo mongosh --eval '
#     db.getSiblingDB("admin").createUser({
#       user: "ims", pwd: "<strong-password>",
#       roles: [{ role: "readWrite", db: "ims" }]
#     })'
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://ims:<password>@mongo:27017/ims?replicaSet=rs0&authSource=admin

# ---------------------------------------------------------------------------
# Browser origins — comma-separated, no trailing slash.
#
# MUST be https: the refresh token is an HttpOnly cookie and needs Secure,
# which a browser only honours over https. Must not contain localhost. Both
# refused at boot, because the default is localhost and leaving it presents as
# a backend outage rather than a configuration mistake.
# ---------------------------------------------------------------------------
CLIENT_URL=https://inventory.yourcompany.com

# ---------------------------------------------------------------------------
# Secrets. Generate EACH ONE SEPARATELY:
#   openssl rand -base64 48
#
# At least 32 characters and the two must differ — one leak must not
# compromise both. Both refused at boot.
#
# Rotating JWT_SECRET signs every user out, which is the intended effect if a
# secret is suspected. Rotating JWT_REFRESH_SECRET invalidates every stored
# session as well.
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Uploads. Both paths must sit on a PERSISTENT VOLUME — in the production
# compose that is the `backend-storage` volume mounted at /app/storage. A path
# outside it loses every uploaded document on the next container rebuild.
# ---------------------------------------------------------------------------
UPLOAD_PATH=/app/storage
DOCUMENT_STORAGE_PATH=/app/storage/documents
MAX_UPLOAD_BYTES=10485760

# "worker" in the worker container, "api" everywhere else.
PROCESS_ROLE=api

# ---------------------------------------------------------------------------
# The generated OpenAPI spec at /api/v1/docs. OFF in production by default: a
# complete list of endpoints with the permission each one demands is a
# reconnaissance gift. Turn it on only behind a VPN or for a short window.
# ---------------------------------------------------------------------------
DOCS_ENABLED=false

# Seed data. Leave false — the demo records are for development.
SEED_DEMO_DATA=false
SEED_COMPANY_NAME=Your Company Private Limited
