{
  "name": "ims-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker:dev": "node --watch worker.js",
    "worker": "node worker.js",
    "lint": "eslint . && node scripts/check-transactional-creates.mjs && node scripts/check-session-threading.mjs && node scripts/check-aggregation-casting.mjs",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:integration": "npm test -- tests/integration",
    "seed": "node src/db/seed.js",
    "check:creates": "node scripts/check-transactional-creates.mjs",
    "check:session": "node scripts/check-session-threading.mjs",
    "check:casting": "node scripts/check-aggregation-casting.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
