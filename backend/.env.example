# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB MUST be a replica set — transactions are required from Phase 3.
# Docker Compose overrides this with the service hostname.
MONGODB_URI=mongodb://localhost:27017/ims?replicaSet=rs0&directConnection=true

# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# Secrets — generate with: openssl rand -base64 48
# Placeholders below are rejected at boot in production.
JWT_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

UPLOAD_PATH=./storage
MAX_UPLOAD_BYTES=10485760

# Set to "worker" in the worker container; anything else runs the API.
PROCESS_ROLE=api

# Where uploaded documents are written. Must be on a persistent volume in production.
DOCUMENT_STORAGE_PATH=./storage/documents
